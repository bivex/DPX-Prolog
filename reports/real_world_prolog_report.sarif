{
  "$schema": "https://raw.githubusercontent.com/oasis-tcs/sarif-spec/master/Schemata/sarif-schema-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "DPX-Prolog",
          "informationUri": "https://github.com/bivex/DPX-Prolog",
          "semanticVersion": "0.1.0",
          "rules": [
            {
              "id": "definite_clause_grammar",
              "name": "DEFINITE_CLAUSE_GRAMMAR",
              "shortDescription": {
                "text": "Definite Clause Grammar (Rule --> ...) for declarative syntactic parsing and difference lists."
              },
              "defaultConfiguration": {
                "level": "note"
              }
            },
            {
              "id": "clpr_real_constraint_solving",
              "name": "CLPR_REAL_CONSTRAINT_SOLVING",
              "shortDescription": {
                "text": "Constraint Logic Programming over Real/Rational numbers ({Equations}) for algebraic reasoning."
              },
              "defaultConfiguration": {
                "level": "note"
              }
            },
            {
              "id": "higher_order_maplist",
              "name": "HIGHER_ORDER_MAPLIST",
              "shortDescription": {
                "text": "Declarative higher-order list processing using maplist/N, include/3, exclude/3, or foldl/4."
              },
              "defaultConfiguration": {
                "level": "note"
              }
            },
            {
              "id": "all_solutions_aggregation",
              "name": "ALL_SOLUTIONS_AGGREGATION",
              "shortDescription": {
                "text": "Second-order aggregation predicates (findall/3, setof/3, bagof/3) collecting solution sets."
              },
              "defaultConfiguration": {
                "level": "note"
              }
            },
            {
              "id": "gof_proxy",
              "name": "GOF_PROXY",
              "shortDescription": {
                "text": "Structural pattern intercepting and rewriting goals via goal_expansion/2 or term_expansion/2."
              },
              "defaultConfiguration": {
                "level": "note"
              }
            },
            {
              "id": "gof_state",
              "name": "GOF_STATE",
              "shortDescription": {
                "text": "Behavioral pattern threading explicit state variables (State0 -> State1 -> StateN) through relations."
              },
              "defaultConfiguration": {
                "level": "note"
              }
            },
            {
              "id": "gof_visitor",
              "name": "GOF_VISITOR",
              "shortDescription": {
                "text": "Behavioral pattern traversing compound terms using univ (=..) and term_variables/2."
              },
              "defaultConfiguration": {
                "level": "note"
              }
            },
            {
              "id": "unsafe_cut_red_cut_hazard",
              "name": "UNSAFE_CUT_RED_CUT_HAZARD",
              "shortDescription": {
                "text": "Procedural cut (!) altering logical semantics and breaking commutativity/declarative purity."
              },
              "defaultConfiguration": {
                "level": "warning"
              }
            },
            {
              "id": "unsafe_dynamic_assert_hazard",
              "name": "UNSAFE_DYNAMIC_ASSERT_HAZARD",
              "shortDescription": {
                "text": "Unmanaged assertz/retract creating memory leaks and dynamic database pollution."
              },
              "defaultConfiguration": {
                "level": "warning"
              }
            },
            {
              "id": "monolithic_module_srp",
              "name": "MONOLITHIC_MODULE_SRP",
              "shortDescription": {
                "text": "Module exports excessive predicates (>25); decompose into focused submodules."
              },
              "defaultConfiguration": {
                "level": "note"
              }
            },
            {
              "id": "fat_predicate_arity_srp",
              "name": "FAT_PREDICATE_ARITY_SRP",
              "shortDescription": {
                "text": "Predicate declares excessive arity (>=8); refactor using compound terms or options lists."
              },
              "defaultConfiguration": {
                "level": "note"
              }
            },
            {
              "id": "impure_state_mutation_srp",
              "name": "IMPURE_STATE_MUTATION_SRP",
              "shortDescription": {
                "text": "Mixing pure logical deduction with assertz/retract side-effects inside relations."
              },
              "defaultConfiguration": {
                "level": "note"
              }
            }
          ]
        }
      },
      "results": [
