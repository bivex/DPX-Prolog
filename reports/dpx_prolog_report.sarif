{
  "$schema": "https://raw.githubusercontent.com/oasis-tcs/sarif-spec/master/Schemata/sarif-schema-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "DPX-Prolog",
          "informationUri": "https://github.com/bivex/DPX-Prolog",
          "semanticVersion": "0.1.0",
          "rules": [
            {
              "id": "definite_clause_grammar",
              "name": "DEFINITE_CLAUSE_GRAMMAR",
              "shortDescription": {
                "text": "Definite Clause Grammar (Rule --> ...) for declarative syntactic parsing and difference lists."
              },
              "defaultConfiguration": {
                "level": "note"
              }
            },
            {
              "id": "clpfd_constraint_reasoning",
              "name": "CLPFD_CONSTRAINT_REASONING",
              "shortDescription": {
                "text": "Constraint Logic Programming over Finite Domains (#=, #>, in, labeling/2) for combinatorial search."
              },
              "defaultConfiguration": {
                "level": "note"
              }
            },
            {
              "id": "clpr_real_constraint_solving",
              "name": "CLPR_REAL_CONSTRAINT_SOLVING",
              "shortDescription": {
                "text": "Constraint Logic Programming over Real/Rational numbers ({Equations}) for algebraic reasoning."
              },
              "defaultConfiguration": {
                "level": "note"
              }
            },
            {
              "id": "constraint_handling_rules",
              "name": "CONSTRAINT_HANDLING_RULES",
              "shortDescription": {
                "text": "Committed-choice rule-based language extension (rule @ Head <=> Guard | Body) for user-defined constraint solvers."
              },
              "defaultConfiguration": {
                "level": "note"
              }
            },
            {
              "id": "tabling_memoization_slg",
              "name": "TABLING_MEMOIZATION_SLG",
              "shortDescription": {
                "text": "SLG Resolution tabling (:- table Pred/Arity.) preventing infinite loops in cyclic graphs."
              },
              "defaultConfiguration": {
                "level": "note"
              }
            },
            {
              "id": "higher_order_maplist",
              "name": "HIGHER_ORDER_MAPLIST",
              "shortDescription": {
                "text": "Declarative higher-order list processing using maplist/N, include/3, exclude/3, or foldl/4."
              },
              "defaultConfiguration": {
                "level": "note"
              }
            },
            {
              "id": "all_solutions_aggregation",
              "name": "ALL_SOLUTIONS_AGGREGATION",
              "shortDescription": {
                "text": "Second-order aggregation predicates (findall/3, setof/3, bagof/3) collecting solution sets."
              },
              "defaultConfiguration": {
                "level": "note"
              }
            },
            {
              "id": "gof_factory_method",
              "name": "GOF_FACTORY_METHOD",
              "shortDescription": {
                "text": "Creational pattern constructing specialized compound functor terms based on type descriptor."
              },
              "defaultConfiguration": {
                "level": "note"
              }
            },
            {
              "id": "gof_abstract_factory",
              "name": "GOF_ABSTRACT_FACTORY",
              "shortDescription": {
                "text": "Creational pattern generating families of related logical records without specifying concrete functors."
              },
              "defaultConfiguration": {
                "level": "note"
              }
            },
            {
              "id": "gof_builder",
              "name": "GOF_BUILDER",
              "shortDescription": {
                "text": "Creational pattern assembling complex terms stepwise via accumulator threading or DCG grammars."
              },
              "defaultConfiguration": {
                "level": "note"
              }
            },
            {
              "id": "gof_prototype",
              "name": "GOF_PROTOTYPE",
              "shortDescription": {
                "text": "Creational pattern cloning terms with fresh variable allocations via copy_term/2 or duplicate_term/2."
              },
              "defaultConfiguration": {
                "level": "note"
              }
            },
            {
              "id": "gof_singleton",
              "name": "GOF_SINGLETON",
              "shortDescription": {
                "text": "Creational pattern maintaining a unique dynamic database fact or global variable (nb_setval)."
              },
              "defaultConfiguration": {
                "level": "note"
              }
            },
            {
              "id": "gof_bridge",
              "name": "GOF_BRIDGE",
              "shortDescription": {
                "text": "Structural pattern decoupling high-level logical relations from backend database/solver drivers."
              },
              "defaultConfiguration": {
                "level": "note"
              }
            },
            {
              "id": "gof_composite",
              "name": "GOF_COMPOSITE",
              "shortDescription": {
                "text": "Structural pattern composing terms into recursive tree structures (node/2, tree/3) handled uniformly."
              },
              "defaultConfiguration": {
                "level": "note"
              }
            },
            {
              "id": "gof_decorator",
              "name": "GOF_DECORATOR",
              "shortDescription": {
                "text": "Structural pattern dynamically wrapping goal evaluation with pre/post hooks, logging, or caching."
              },
              "defaultConfiguration": {
                "level": "note"
              }
            },
            {
              "id": "gof_flyweight",
              "name": "GOF_FLYWEIGHT",
              "shortDescription": {
                "text": "Structural pattern sharing immutable atomic terms and symbol tables using trie indexing."
              },
              "defaultConfiguration": {
                "level": "note"
              }
            },
            {
              "id": "gof_proxy",
              "name": "GOF_PROXY",
              "shortDescription": {
                "text": "Structural pattern intercepting and rewriting goals via goal_expansion/2 or term_expansion/2."
              },
              "defaultConfiguration": {
                "level": "note"
              }
            },
            {
              "id": "gof_chain_of_responsibility",
              "name": "GOF_CHAIN_OF_RESPONSIBILITY",
              "shortDescription": {
                "text": "Behavioral pattern passing requests through disjunctive clause branches until one succeeds."
              },
              "defaultConfiguration": {
                "level": "note"
              }
            },
            {
              "id": "gof_command",
              "name": "GOF_COMMAND",
              "shortDescription": {
                "text": "Behavioral pattern encapsulating an executable goal as a reified term executed via call/N or catch/3."
              },
              "defaultConfiguration": {
                "level": "note"
              }
            },
            {
              "id": "gof_interpreter",
              "name": "GOF_INTERPRETER",
              "shortDescription": {
                "text": "Behavioral pattern evaluating domain-specific grammar or AST expression trees."
              },
              "defaultConfiguration": {
                "level": "note"
              }
            },
            {
              "id": "gof_iterator",
              "name": "GOF_ITERATOR",
              "shortDescription": {
                "text": "Behavioral pattern generating elements sequentially on backtracking (member/2, between/3)."
              },
              "defaultConfiguration": {
                "level": "note"
              }
            },
            {
              "id": "gof_mediator",
              "name": "GOF_MEDIATOR",
              "shortDescription": {
                "text": "Behavioral pattern coordinating colleague predicates through a centralized dynamic blackboard."
              },
              "defaultConfiguration": {
                "level": "note"
              }
            },
            {
              "id": "gof_memento",
              "name": "GOF_MEMENTO",
              "shortDescription": {
                "text": "Behavioral pattern recording database snapshots and transactional state checkpoints for rollback."
              },
              "defaultConfiguration": {
                "level": "note"
              }
            },
            {
              "id": "gof_observer",
              "name": "GOF_OBSERVER",
              "shortDescription": {
                "text": "Behavioral pattern broadcasting events to registered listener predicates or dynamic hook tables."
              },
              "defaultConfiguration": {
                "level": "note"
              }
            },
            {
              "id": "gof_state",
              "name": "GOF_STATE",
              "shortDescription": {
                "text": "Behavioral pattern threading explicit state variables (State0 -> State1 -> StateN) through relations."
              },
              "defaultConfiguration": {
                "level": "note"
              }
            },
            {
              "id": "gof_strategy",
              "name": "GOF_STRATEGY",
              "shortDescription": {
                "text": "Behavioral pattern injecting interchangeable algorithmic goal closures into call/N or maplist/N."
              },
              "defaultConfiguration": {
                "level": "note"
              }
            },
            {
              "id": "gof_template_method",
              "name": "GOF_TEMPLATE_METHOD",
              "shortDescription": {
                "text": "Behavioral pattern defining skeleton relation calling customizable multifile hook predicates."
              },
              "defaultConfiguration": {
                "level": "note"
              }
            },
            {
              "id": "gof_visitor",
              "name": "GOF_VISITOR",
              "shortDescription": {
                "text": "Behavioral pattern traversing compound terms using univ (=..) and term_variables/2."
              },
              "defaultConfiguration": {
                "level": "note"
              }
            },
            {
              "id": "unsafe_cut_red_cut_hazard",
              "name": "UNSAFE_CUT_RED_CUT_HAZARD",
              "shortDescription": {
                "text": "Procedural cut (!) altering logical semantics and breaking commutativity/declarative purity."
              },
              "defaultConfiguration": {
                "level": "warning"
              }
            },
            {
              "id": "unsafe_term_evaluation_hazard",
              "name": "UNSAFE_TERM_EVALUATION_HAZARD",
              "shortDescription": {
                "text": "Evaluating untrusted goal input via call/N or atom_to_term/3 risking arbitrary code execution."
              },
              "defaultConfiguration": {
                "level": "warning"
              }
            },
            {
              "id": "unsafe_dynamic_assert_hazard",
              "name": "UNSAFE_DYNAMIC_ASSERT_HAZARD",
              "shortDescription": {
                "text": "Unmanaged assertz/retract creating memory leaks and dynamic database pollution."
              },
              "defaultConfiguration": {
                "level": "warning"
              }
            },
            {
              "id": "unsafe_io_system_hazard",
              "name": "UNSAFE_IO_SYSTEM_HAZARD",
              "shortDescription": {
                "text": "Executing shell commands (shell/1, process_create/3) with unsanitized atom arguments."
              },
              "defaultConfiguration": {
                "level": "warning"
              }
            },
            {
              "id": "infinite_left_recursion_hazard",
              "name": "INFINITE_LEFT_RECURSION_HAZARD",
              "shortDescription": {
                "text": "Direct left recursion in clause body causing infinite loops during SLD resolution."
              },
              "defaultConfiguration": {
                "level": "warning"
              }
            },
            {
              "id": "uninstantiated_var_negation_hazard",
              "name": "UNINSTANTIATED_VAR_NEGATION_HAZARD",
              "shortDescription": {
                "text": "Calling negation (\\+ or not) on uninstantiated variables producing unsound logical answers."
              },
              "defaultConfiguration": {
                "level": "warning"
              }
            },
            {
              "id": "monolithic_module_srp",
              "name": "MONOLITHIC_MODULE_SRP",
              "shortDescription": {
                "text": "Module exports excessive predicates (>25); decompose into focused submodules."
              },
              "defaultConfiguration": {
                "level": "note"
              }
            },
            {
              "id": "fat_predicate_arity_srp",
              "name": "FAT_PREDICATE_ARITY_SRP",
              "shortDescription": {
                "text": "Predicate declares excessive arity (>=8); refactor using compound terms or options lists."
              },
              "defaultConfiguration": {
                "level": "note"
              }
            }
          ]
        }
      },
